{
  "name": "jkurwa",
  "version": "1.22.4",
  "description": "Ukrainian national EC cryptography (DSTU-4145) implementaion",
  "type": "module",
  "main": "dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": "./*"
  },
  "files": [
    "dist",
    "lib",
    "types",
    "README.md",
    "README.uk.md",
    "CHANGES.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "browser": {
    "./lib/rand.js": "./lib/rand.browser.js",
    "fs": false
  },
  "scripts": {
    "test": "vitest run",
    "cover": "npm run test -- --coverage",
    "lint": "eslint lib test examples",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write lib test examples",
    "prepare": "npm run build",
    "prepublishOnly": "npm run test",
    "build": "esbuild ./lib/index.js --outdir=./dist/ --bundle --platform=node --format=esm --external:asn1.js --external:js-lzma --external:js-sha1 --external:jksreader --external:gost89 --external:@li0ard/kupyna",
    "build:bundle": "esbuild ./lib/index.js --outfile=./dist/index.bundle.js --bundle --platform=node --format=esm --banner:js=\"import { createRequire as __cr } from 'module'; const require = __cr(import.meta.url);\"",
    "build:browser": "esbuild ./lib/index.js --outfile=./dist/jkurwa.browser.js --bundle --platform=browser --format=iife --global-name=jkurwa"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:dstucrypt/jkurwa"
  },
  "keywords": [
    "ecc",
    "cryptography",
    "dstu4145",
    "ukraine"
  ],
  "author": "Ilya Petrov",
  "license": "BSD-2-Clause",
  "bugs": {
    "url": "https://github.com/dstucrypt/jkurwa/issues"
  },
  "homepage": "https://github.com/dstucrypt/jkurwa/",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.25.5",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "gost89": "^0.1.11",
    "prettier": "^3.9.5",
    "typescript": "^5.0.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.1"
  },
  "dependencies": {
    "@li0ard/kupyna": "^0.1.4",
    "asn1.js": "github:muromec/asn1.js#7ca2c330ec52fbb5676dd4d54f55fb95b778ba91",
    "bn.js": "^4.11.8",
    "buffer": "^5.2.1",
    "jksreader": "^1.0.0",
    "js-lzma": "0.x"
  }
}
